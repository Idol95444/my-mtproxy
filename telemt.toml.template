[general]
fast_mode = true
use_middle_proxy = true
# При старте ME-пул падал целиком (alive=0 для dc=2,3,-2): дефолтные 0 попыток
# не переживают лавину переподключений после рестарта. Применяется только при старте.
me_init_retry_attempts = 3
# Коннект к DC Telegram: на 10с ловили Connection timeout к 149.154.167.51
tg_connect = 20

[general.modes]
classic = false
secure = true
tls = true

[network]
ipv4 = true
ipv6 = false
prefer = 4

[server]
port = __PORT__
listen_addr_ipv4 = "0.0.0.0"
client_mss = "tspu"

[server.api]
enabled = true
listen = "127.0.0.1:__API_PORT__"
whitelist = ["127.0.0.1/32"]

[censorship]
tls_domain = "__TLS_DOMAIN__"
mask = false
mask_port = 8443
tls_emulation = true
# drop молча убивал и своих: живые пользователи попадали в beobachten.txt.
# Значение mask здесь нерабочее — оно требует бэкенда на mask_port.
# Допустимые: drop | mask | accept | reject_handshake
unknown_sni_action = "accept"

[access]
replay_check_len = 65536
ignore_time_skew = false

[access.users]
user1 = "__BASE_SECRET__"
