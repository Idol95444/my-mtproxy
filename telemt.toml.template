[general]
fast_mode = true
use_middle_proxy = true
# ВНИМАНИЕ: не помогло. Отказ ME-пула при старте (alive=0 для dc=2,-2,3,-3)
# воспроизводится и с 3, и с 0; на замерах 28.08.2026 корреляции с этим ключом нет
# (0 -> 0 и 3 отказа, 3 -> 6 и 4 отказа). Пул сам добирает до 100% за ~минуту.
# Оставлено как безвредное; настоящую причину искать в timeouts.me_one_retry /
# me_one_timeout_ms / me_warmup_*, см. docs/Advanced_settings/TUNING.ru.md.
me_init_retry_attempts = 3
# Коннект к DC Telegram: на 10с ловили Connection timeout к 149.154.167.51
tg_connect = 20
# Путь до DC2 (149.154.167.51) теряет ~35% SYN (mtr -T -P 443, 29.08.2026): единичные
# таймауты connect за 3с ронял upstream в unhealthy (порог 5) -> ME-пул not-ready ->
# cutover рвал ВСЕ живые сессии ~25 раз/час. Даём бюджет на ретрансмит SYN и терпим
# больше отказов, прежде чем объявлять upstream мёртвым.
upstream_connect_budget_ms = 8000
upstream_connect_retry_attempts = 3
upstream_unhealthy_fail_threshold = 20
me_reconnect_fast_retry_count = 32
# DC2 у ME-пула — единственный эндпоинт (endpoint_count=1). Замер 29.08 19:53-20:14:
# shadow_writers=4 поднял required с 3 до 5 и не помог — все оставшиеся cutover'ы шли
# от «Single-endpoint DC outage detected dc=2». Этот агрессивный режим выключаем: пусть
# пул просто переподключает writer, не объявляя not-ready и не роняя всех в direct.
me_single_endpoint_shadow_writers = 2
me_single_endpoint_outage_mode_enabled = false
# Плановый реинит пула раз в 900с (дефолт) каждый раз объявлял пул not-ready
# («reinit proceeds with weighted quorum ... missing_dc=[203]») -> cutover -> обрыв всех
# сессий по расписанию, 4 раза в час. Реинит нужен только для подхвата новой карты ME;
# делаем раз в 6 часов.
me_reinit_every_secs = 21600
# Настоящий механизм качелей (info-лог 29.08 21:31-21:53): ME-сторона DC2 массово
# сбрасывает writer'ы, пул на 3-7 с проваливается ниже пола (alive=1 required=3), а
# me2dc_fast мгновенно объявляет not-ready и cutover закрывает ВСЕ сессии; через
# секунды всё возвращается. С me2dc_fast=false admission ждёт 6 с (strict grace) и
# уходит в direct только если пул не восстановился — короткие провалы никого не рвут.
me2dc_fast = false

[general.modes]
classic = false
secure = true
tls = true

[network]
ipv4 = true
ipv6 = false
prefer = 4

[server]
port = __PORT__
listen_addr_ipv4 = "0.0.0.0"
client_mss = "tspu"
# client_mss=tspu -> MSS 92 на ВСЁ соединение, множитель сегментов ceil(1460/92)=16,
# то есть 16-кратные накладные расходы на медиа. client_mss_bulk держит 92 только
# на время ServerHello (что и смотрит DPI), а дальше отдаёт 1400: множитель падает
# до 2. Подтверждено на живых сокетах: ss -tni показывает mss:1388/1400 вместо 92.
client_mss_bulk = "1400"

[server.api]
enabled = true
listen = "127.0.0.1:__API_PORT__"
whitelist = ["127.0.0.1/32"]

[censorship]
tls_domain = "__TLS_DOMAIN__"
mask = false
mask_port = 8443
tls_emulation = true
# Допустимые: drop | mask | accept | reject_handshake.
# mask здесь нерабочее — требует живого бэкенда на mask_port.
# accept документация не советует: «снижает защиту от активного пробинга».
# reject_handshake — рекомендованный вариант: фатальный TLS-alert unrecognized_name,
# на wire выглядит как nginx с ssl_reject_handshake on.
unknown_sni_action = "reject_handshake"

[access]
replay_check_len = 65536
ignore_time_skew = false

[access.users]
user1 = "__BASE_SECRET__"
